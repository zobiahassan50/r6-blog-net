---
import "@/styles/starwind.css";
import { t } from '../i18n';
import {
  RSS_FEED_PATH,
  TWITTER_CREATOR,
  TWITTER_SITE,
  canonicalUrl,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  GA_MEASUREMENT_ID,
  absoluteAssetUrl,
  formatMetaDescription,
} from '../config/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = t.site.title,
  description = t.site.description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const ogImageUrl = absoluteAssetUrl(ogImage);
const metaDesc = formatMetaDescription(description);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const incomingJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const hasOrgOrSite = incomingJsonLd.some((item) => {
  if (!item || typeof item !== 'object') return false;
  const type = (item as Record<string, unknown>)['@type'];
  return (
    type === 'Organization' ||
    type === 'WebSite' ||
    (Array.isArray(type) && (type.includes('Organization') || type.includes('WebSite')))
  );
});
const resolvedJsonLd = hasOrgOrSite
  ? incomingJsonLd
  : [organizationSchema(), ...incomingJsonLd];
---

<!doctype html>
<html lang="en" class="fonts-pending">
  <head>
    <meta charset="UTF-8" />
    <!-- Preconnect to checkout & external domains for faster navigation -->
    <link rel="preconnect" href="https://zadeyo.com" />
    <link rel="dns-prefetch" href="https://zadeyo.com" />
    <script is:inline>
      (function () {
        try {
          var themeVal = localStorage.getItem('theme');
          var colorVal = localStorage.getItem('colorTheme');
          var swVal = localStorage.getItem('starwind-theme');
          var stored = themeVal || colorVal || swVal;
          if (themeVal === 'light' || colorVal === 'light' || swVal === 'light') {
            stored = 'light';
          }
          var isDark = stored ? stored === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches !== false);
          document.documentElement.classList.toggle('dark', isDark);
          var mode = isDark ? 'dark' : 'light';
          localStorage.setItem('theme', mode);
          localStorage.setItem('colorTheme', mode);
          localStorage.setItem('starwind-theme', mode);
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
        document.documentElement.classList.add('fonts-pending');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    <meta name="author" content={t.site.name} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#7F3DEE" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={t.site.name} />
    <meta name="application-name" content={t.site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.site.name} Blog RSS`}
      href={RSS_FEED_PATH}
    />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {/* Async font faces — keeps woff2 off the HTML→CSS→font critical chain */}
    <link
      rel="stylesheet"
      href="/fonts/faces.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="/fonts/faces.css" />
    </noscript>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content="en_US" />

    {
      ogType === 'article' && articlePublishedTime && (
        <>
          <meta property="article:published_time" content={articlePublishedTime} />
          <meta
            property="article:modified_time"
            content={articleModifiedTime ?? articlePublishedTime}
          />
          <meta property="article:author" content={t.site.name} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:site" content={TWITTER_SITE || '@r6cheats'} />
    <meta name="twitter:creator" content={TWITTER_CREATOR || '@r6cheats'} />

    <JsonLd data={resolvedJsonLd} />
    <slot name="head" />

  </head>
  <body class="min-h-screen bg-background text-foreground">
    <button type="button" class="skip-link" data-skip-to-main>{t.ui.skipLink}</button>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    {
      GA_MEASUREMENT_ID && (
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          (() => {
            const loadGa = () => {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag() {
                dataLayer.push(arguments);
              }
              gtag('js', new Date());
              gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
              const s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
              s.async = true;
              document.head.appendChild(s);
            };
            const onReady = () => {
              if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(loadGa, { timeout: 4000 });
              } else {
                window.setTimeout(loadGa, 2500);
              }
            };
            if (document.readyState === 'complete') onReady();
            else window.addEventListener('load', onReady, { once: true });
          })();
        </script>
      )
    }
  </body>
</html>
