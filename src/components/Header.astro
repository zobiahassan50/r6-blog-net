---
import { t } from '../i18n';
import { R6_BUY_URL } from '../config/checkout';
import { Button } from '@/components/starwind/button';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';
import { ThemeToggle } from '@/components/starwind/theme-toggle';

import type { IconName } from './icons/types';

const navIcons: Record<string, IconName> = {
  Home: 'navHome',
  Products: 'navProducts',
  Blog: 'navBlog',
  Forum: 'messageCircle',
  FAQ: 'navFaq',
  Support: 'navSupport',
};

const purchaseUrl = R6_BUY_URL;
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="pointer-events-auto relative flex h-14 w-full max-w-6xl items-center justify-between gap-3 rounded-2xl border border-neutral-200 bg-white/95 px-4 text-neutral-950 shadow-md shadow-black/5 backdrop-blur-2xl supports-[backdrop-filter]:bg-white/90 dark:border-white/10 dark:bg-background/20 dark:text-foreground dark:shadow-black/25 dark:supports-[backdrop-filter]:bg-background/20 sm:px-5 lg:h-[3.75rem]"
    >
    <a href="/" class="inline-flex min-w-0 items-center font-[family-name:var(--font-heading)] text-lg font-bold tracking-wide" aria-label={t.ui.homeAria}>
      <span class="truncate" aria-hidden="true">R6<span class="text-primary">Cheats</span></span>
    </a>

    <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 lg:flex" aria-label="Primary">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="nav-link inline-flex items-center text-sm font-medium text-neutral-800 transition-colors hover:text-primary dark:text-muted-foreground"
          data-nav-link
          {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle
        size="sm"
        variant="outline"
        class="relative z-10 size-9 shrink-0 rounded-lg border border-neutral-300 bg-white text-neutral-900 shadow-sm dark:border-border/80 dark:bg-background/50 dark:text-foreground"
        ariaLabel="Toggle light and dark mode"
        defaultPressed={true}
      />
      <div class="hidden items-center sm:flex">
        <SlideRevealButton href={purchaseUrl} class="hidden lg:inline-flex" ariaLabel={t.ui.checkoutAria}>
          {t.ui.browseCheats}
        </SlideRevealButton>
      </div>

      <details class="mobile-nav relative lg:hidden">
        <summary
          class="mobile-nav__summary inline-flex size-9 list-none items-center justify-center rounded-lg border border-neutral-200 bg-white text-neutral-900 transition-colors hover:bg-neutral-50 dark:border-border/80 dark:bg-background/50 dark:text-foreground dark:hover:bg-muted"
          aria-label={t.ui.menuOpen}
        >
          <Icon name="menu" size={20} />
        </summary>
        <div
          class="mobile-nav__panel absolute right-0 top-[calc(100%+0.5rem)] z-50 flex w-[min(100vw-2rem,20rem)] flex-col gap-4 rounded-xl border border-neutral-200 bg-white p-4 shadow-lg dark:border-border dark:bg-card"
        >
          <p class="font-[family-name:var(--font-heading)] text-base font-semibold text-neutral-950 dark:text-foreground">{t.site.name}</p>
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {t.nav.map((link) => (
              <a
                href={link.href}
                class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
                data-nav-link
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                <Icon name={navIcons[link.label] ?? 'navFeatures'} size={16} />
                {link.label}
              </a>
            ))}
          </nav>
          <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria} target="_self">
            {t.ui.browseCheatsMobile}
          </Button>
        </div>
      </details>
    </div>
    </div>
  </div>
</header>
