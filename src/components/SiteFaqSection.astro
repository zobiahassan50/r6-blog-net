---
import type { SiteFaqItem, FaqTopic } from '../data/faq';
import FaqSection from './FaqSection.astro';
import {
  SITE_FAQ_FILTER_TOPICS,
  SITE_FAQ_SECTION_COPY,
  CONTEXTUAL_FAQ_SECTION_COPY,
  faqFilterTopicsForItems,
} from '../data/faq';

interface Props {
  items: SiteFaqItem[];
  id?: string;
  titleId?: string;
  class?: string;
  /** Full /faq/ experience — all topics chip bar */
  variant?: 'full' | 'contextual';
  filterTopics?: FaqTopic[];
  headingLevel?: 'h1' | 'h2';
  /** Optional overrides so embedded FAQs do not share identical section copy. */
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  items,
  id,
  titleId = 'faq-heading',
  class: className,
  variant = 'contextual',
  filterTopics: filterTopicsProp,
  headingLevel = variant === 'full' ? 'h1' : 'h2',
  eyebrow,
  title,
  subtitle,
} = Astro.props;

const copy = variant === 'full' ? SITE_FAQ_SECTION_COPY : CONTEXTUAL_FAQ_SECTION_COPY;
const filterTopics =
  filterTopicsProp ?? (variant === 'full' ? SITE_FAQ_FILTER_TOPICS : faqFilterTopicsForItems(items));
const showFilters = filterTopics.length > 1;
---

<FaqSection
  id={id}
  items={items}
  eyebrow={eyebrow ?? copy.eyebrow}
  title={title ?? copy.title}
  subtitle={subtitle ?? copy.subtitle}
  titleId={titleId}
  showFilters={showFilters}
  filterTopics={filterTopics}
  headingLevel={headingLevel}
  class={className}
/>
