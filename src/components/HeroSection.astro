---
import { t } from '../i18n';
import { R6_BUY_URL } from '../config/checkout';
import { ROUTES } from '../utils/path';
import { compatibilityIcons, heroStatIcons, heroStatusPills } from '../data/sectionIcons';
import {
  HERO_BG_SIZES,
  HERO_BG_WIDTHS,
  responsiveSrcSet,
} from '../utils/responsiveImage';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';

const h = t.hero;
/** Absolute public path — case-sensitive on Cloudflare; keep PNG as reliable fallback. */
const heroBgSrc = '/images/herobackground.png';
const heroBgWebpSrcSet = responsiveSrcSet(heroBgSrc, HERO_BG_WIDTHS, 'webp');
const heroBgAvifSrcSet = responsiveSrcSet(heroBgSrc, HERO_BG_WIDTHS, 'avif');


const heroMarqueePills = [
  ...heroStatusPills,
  ...t.compatibility.items.map((label, i) => ({
    label,
    icon: compatibilityIcons[i] ?? 'check',
  })),
];
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border bg-[url('/images/herobackground.png')] bg-cover bg-center"
  aria-labelledby="hero-title"
>
  <picture class="pointer-events-none absolute inset-0" aria-hidden="true">
    <source type="image/avif" srcset={heroBgAvifSrcSet} sizes={HERO_BG_SIZES} />
    <source type="image/webp" srcset={heroBgWebpSrcSet} sizes={HERO_BG_SIZES} />
    <img
      src="/images/herobackground.png"
      srcset={heroBgWebpSrcSet}
      sizes={HERO_BG_SIZES}
      alt=""
      class="h-full w-full object-cover brightness-[0.45]"
      width="1920"
      height="1080"
      decoding="async"
      fetchpriority="high"
      loading="eager"
    />
  </picture>
  <div class="pointer-events-none absolute inset-0 bg-black/55" aria-hidden="true" />
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--primary)_0%,transparent_55%)] opacity-20" aria-hidden="true" />

  <div class="relative mx-auto flex max-w-6xl flex-col justify-center px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="w-full max-w-xl space-y-6 text-left md:space-y-7 lg:max-w-2xl">
        <Badge variant="secondary" class="uppercase tracking-wider">{h.eyebrow}</Badge>

        <h1 id="hero-title" class="text-4xl font-bold uppercase leading-tight md:text-5xl">
          <span class="block text-primary">{h.titleLine2}</span>
        </h1>

        <p class="max-w-xl text-sm leading-relaxed text-white/90 md:text-base">
          {h.subtitle}
        </p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <Button
            as="a"
            href={ROUTES.products}
            data-scroll-target="products"
            variant="primary"
            size="lg"
            class="rounded-xl"
          >
            {h.ctaPrimary}
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            as="a"
            href={R6_BUY_URL}
            variant="secondary"
            size="lg"
            class="rounded-xl"
            target="_self"
          >
            <Icon name="messageCircle" size={18} />
            {h.ctaDiscord}
          </Button>
        </div>
      </div>

      <div class="mx-auto flex w-full max-w-xl flex-col items-center gap-5 lg:mx-0 lg:max-w-none lg:items-end">
        <div
          id="hero-slider"
          class="relative hidden w-full rounded-xl border border-border bg-card p-2 shadow-sm lg:block"
        >
          <video
            class="aspect-[16/10] w-full rounded-lg bg-muted/30 object-cover"
            muted
            loop
            playsinline
            preload="none"
            data-hero-video
            aria-label="Rainbow Six Siege product preview"
          ></video>
        </div>
        <div class="grid w-full grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div class="flex min-w-0 items-center gap-3 rounded-xl border border-border/80 bg-card/70 px-3 py-3 shadow-sm shadow-black/10 transition-colors hover:border-primary/40">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/15 ring-1 ring-inset ring-primary/25"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight text-foreground">{m.strong}</p>
                <p class="mt-1 text-xs leading-tight text-muted-foreground">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="hero-status-marquee relative mt-10 md:mt-12 lg:mt-14" aria-label="Features and platform support">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-black/80 to-transparent" aria-hidden="true" />
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-black/80 to-transparent" aria-hidden="true" />
      <div class="hero-status-marquee-track flex w-max gap-2">
        {[...heroMarqueePills, ...heroMarqueePills].map((pill) => (
          <Badge variant="outline" class="group/badge shrink-0 gap-1 border-white/35 bg-black/35 py-0.5 pl-1.5 pr-2.5 text-xs text-white whitespace-nowrap">
            <Icon name={pill.icon} size={13} class="text-white" />
            {pill.label}
          </Badge>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const loadHeroVideo = () => {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video || video.dataset.loaded === '1') return;
    if (!window.matchMedia('(min-width: 1024px)').matches) return;

    const source = document.createElement('source');
    source.src = '/videos/hero.mp4';
    source.type = 'video/mp4';
    video.appendChild(source);
    video.dataset.loaded = '1';
    video.autoplay = true;
    void video.play().catch(() => {});
  };

  loadHeroVideo();
  window.matchMedia('(min-width: 1024px)').addEventListener('change', loadHeroVideo);
  window.addEventListener('load', loadHeroVideo, { once: true });
</script>
