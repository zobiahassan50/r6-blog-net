---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import SiteLogo from './SiteLogo.astro';

const resourceLinks = [
  { href: '/blog/', label: 'Blog archive' },
  { href: '/forum/', label: 'Forum' },
  { href: '/products/r6-cheats/elite/', label: 'Elite cheats' },
  { href: '/products/r6-cheats/', label: 'Products & utilities' },
  { href: '/support/', label: t.footer.support },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
];
---

<footer class="border-t border-neutral-200 bg-neutral-50 py-16 dark:border-border dark:bg-muted/30">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold text-neutral-950 dark:text-foreground" aria-label={t.ui.homeAria}>
          <SiteLogo width={32} height={32} class="rounded-md" loading="lazy" />
          <span aria-hidden="true">R6<span class="text-primary">Cheats</span></span>
        </a>
        <p class="text-sm text-neutral-700 dark:text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-neutral-700 transition-colors hover:text-primary dark:text-muted-foreground"
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-700 transition-colors hover:text-primary dark:text-muted-foreground">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-700 transition-colors hover:text-primary dark:text-muted-foreground">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-neutral-600 dark:text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
