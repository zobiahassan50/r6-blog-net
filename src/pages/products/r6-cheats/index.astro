---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productHub, siegeCatalogCards } from '../../../data/products';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductShowcase from '../../../components/ProductShowcase.astro';

const seo = resolvePageSeo('/products/r6-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

const listedProducts = siegeCatalogCards.filter((card) => card.label !== 'Included with Siege');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      listedProducts.map((product) => ({
        name: product.title,
        url: product.href,
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6 max-w-3xl space-y-4 text-sm leading-relaxed text-muted-foreground md:text-base">
        <p>
          This R6 Siege Products Hub collects ESP, aimbot, and recoil options for Rainbow Six Siege on Windows PC.
          Use it to compare the live RAINBOW SIX SIEGE listing before you open checkout.
        </p>
        <p>
          Monthly access is commonly listed at $35 for 31 days, with lifetime priced higher when offered. Utilities such as
          UGC and Skin Changer sit beside combat modules so you can pick the tool that matches your goal—without treating
          blog guides as the inventory.
        </p>
        <p>
          After every BattlEye or Siege patch, re-check the status note on this products hub. If the banner says updating
          or offline, wait before ranked. Cloud DMA, HVCI, and Secure Boot expectations are spelled out on the detail pages.
        </p>
      </div>
      <div class="mt-8">
        <ProductShowcase heading="h1" titleId="products-page-title" />
      </div>
    </div>
  </section>
</BaseLayout>
