---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productHub, siegeCatalogCards } from '../../../data/products';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductShowcase from '../../../components/ProductShowcase.astro';

const seo = resolvePageSeo('/products/r6-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

const listedProducts = siegeCatalogCards.filter((card) => card.label !== 'Included with Siege');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      listedProducts.map((product) => ({
        name: product.title,
        url: product.href,
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-8">
        <ProductShowcase heading="h1" titleId="products-page-title" />
      </div>
      <div class="mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-muted-foreground md:text-base">
        <p>
          This R6 Siege Products Hub groups Rainbow Six Siege cheats in one place—ESP, wallhack overlays, aimbot, and
          recoil tools under the live RAINBOW SIX SIEGE listing.
        </p>
        <p>
          Browse player ESP, gadget ESP, wallhack-style markers, aim helpers, and related cheat modules side by side.
          Utilities such as UGC and Skin Changer sit next to combat products when you want extras beyond ESP and aimbot.
        </p>
        <p>
          Use this hub to compare which R6 cheats, ESP options, and wallhack features each product covers, then open the
          listing that matches the modules you care about.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
