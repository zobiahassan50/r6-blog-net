---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllProductSlugs, getProductPage, productHub } from '../../../data/products';
import { pageTitle } from '../../../config/seo';
import { breadcrumbSchema, productSchema } from '../../../utils/schema';
import ProductDetail from '../../../components/ProductDetail.astro';
import {
  GALLERY_IMAGE_WIDTHS,
  avifSrc,
  defaultWebpSrc,
  publicAssetExists,
  responsiveAvifSrcSet,
} from '../../../utils/responsiveImage';

export function getStaticPaths() {
  return getAllProductSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = getProductPage(slug!);

if (!product) {
  return Astro.redirect(productHub.path);
}

const pagePath = `${productHub.path}${product.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: product.title, path: pagePath },
];

const firstImage = product.images[0]?.src;
const firstAvifSet = firstImage ? responsiveAvifSrcSet(firstImage, GALLERY_IMAGE_WIDTHS) : undefined;
const galleryPreload = firstImage
  ? firstAvifSet
    ? avifSrc(firstImage, GALLERY_IMAGE_WIDTHS[0])
    : defaultWebpSrc(firstImage, GALLERY_IMAGE_WIDTHS)
  : null;
const galleryPreloadType = firstAvifSet ? 'image/avif' : 'image/webp';
---

<BaseLayout
  title={pageTitle(product.title)}
  description={product.desc}
  ogImage={firstImage}
  jsonLd={[
    productSchema({
      name: product.title,
      description: product.desc,
      url: pagePath,
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: product.slug,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  {
    galleryPreload && publicAssetExists(galleryPreload) && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={galleryPreload}
        type={galleryPreloadType}
        fetchpriority="high"
      />
    )
  }
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
