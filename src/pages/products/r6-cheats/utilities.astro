---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productHub, productPages } from '../../../data/products';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, itemListSchema, webPageSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { productPath } from '../../../utils/path';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/starwind/table';

const utilities = productPages.filter((p) => p.kind === 'utility');
const seo = resolvePageSeo('/products/r6-cheats/utilities/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: 'Compare utilities', path: '/products/r6-cheats/utilities/' },
];

const utilityUseCases: Record<string, string> = {
  ugc: 'Structured appeal and account recovery workflows when access is restricted.',
  'unlock-all': 'Local cosmetic preview and loadouts without buying every elite uniform on Ubisoft Connect.',
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: 'Compare Rainbow Six Siege utilities',
      description: seo.description,
      url: '/products/r6-cheats/utilities/',
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      utilities.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mt-6 max-w-3xl space-y-4">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">Compare utilities</h1>
        <p class="text-lg text-muted-foreground">
          Rainbow Six Siege Utilities on r6cheat.net cover UGC Account Recovery and the Skin Changer Utility. They solve
          different problems than Elite combat modules—match the tool to your situation before checkout.
        </p>
        <p class="text-sm leading-relaxed text-muted-foreground md:text-base">
          UGC focuses on appeal paperwork when Ubisoft Connect or BattlEye restricts an account. Skin Changer Utility
          previews cosmetics locally without rewriting the Ubisoft store. Neither page replaces the ESP and aimbot notes on
          the main R6 Siege Products Hub.
        </p>
        <p class="text-sm leading-relaxed text-muted-foreground md:text-base">
          Read each utility’s limitations block carefully: UGC does not guarantee restorations, and Skin Changer previews
          are visible only on your client. When you need player ESP or aimbot, open the Elite listing instead of forcing a
          utility into a combat role.
        </p>
      </header>

      <div class="mt-10 rounded-lg border border-border" tabindex="0" aria-label="Utility comparison">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Utility</TableHead>
              <TableHead>Best for</TableHead>
              <TableHead>Product page</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {utilities.map((product) => (
              <TableRow>
                <TableCell class="font-medium">{product.title}</TableCell>
                <TableCell class="text-muted-foreground">{utilityUseCases[product.slug] ?? product.desc}</TableCell>
                <TableCell>
                  <a href={productPath(product.slug)} class="text-primary hover:underline">
                    View {product.category ?? 'details'}
                  </a>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>

      <ul class="mt-10 space-y-4">
        {utilities.map((product) => (
          <li>
            <Card>
              <CardHeader>
                <CardTitle class="text-lg normal-case">
                  <a href={productPath(product.slug)} class="hover:text-primary">{product.title}</a>
                </CardTitle>
              </CardHeader>
              <CardContent class="space-y-2 text-sm text-muted-foreground">
                <p>{product.desc}</p>
                <p>
                  <span class="font-semibold text-foreground">Includes:</span>{' '}
                  {product.features.slice(0, 4).join(' · ')}
                  {product.more > 0 ? ` · +${product.more} more` : ''}
                </p>
              </CardContent>
            </Card>
          </li>
        ))}
      </ul>

      <div class="mt-10">
        <Button as="a" href={productHub.path} variant="outline">Back to products</Button>
      </div>
    </div>
  </section>
</BaseLayout>
