---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, getBlogTags } from '../../data/blog';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';
import { defaultWebpSrc, responsiveSrcSet, CARD_IMAGE_WIDTHS } from '../../utils/responsiveImage';

const seo = resolvePageSeo('/blog/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const tags = getBlogTags();
const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
const firstPost = blogPosts[0];
const firstImagePreload = firstPost ? defaultWebpSrc(firstPost.image, CARD_IMAGE_WIDTHS) : null;
const firstImageSrcSet = firstPost
  ? responsiveSrcSet(firstPost.image, CARD_IMAGE_WIDTHS, 'webp')
  : null;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: t.blog.heroTitle,
      description: t.blog.subtitle,
      url: '/blog/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link slot="head" rel="preload" as="video" href="/videos/blog-hero.mp4" type="video/mp4" fetchpriority="high" />
  {
    firstImagePreload && (
      <link
        slot="head"
        rel="preload"
        as="image"
        type="image/webp"
        href={firstImagePreload}
        imagesrcset={firstImageSrcSet ?? undefined}
        imagesizes="(min-width: 1024px) 352px, (min-width: 640px) 50vw, 100vw"
        fetchpriority="high"
      />
    )
  }
  <section class="relative isolate overflow-hidden border-b border-border" aria-labelledby="blog-hero-title">
    <video
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      fetchpriority="high"
      aria-hidden="true"
    >
      <source src="/videos/blog-hero.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/70" aria-hidden="true"></div>

    <div class="relative mx-auto flex min-h-[28rem] max-w-6xl flex-col justify-center px-5 py-16 md:min-h-[34rem] md:py-20">
      <div class="text-white/80 [&_[data-slot=breadcrumb-link]]:text-white/80 [&_[data-slot=breadcrumb-link]:hover]:text-white [&_[data-slot=breadcrumb-page]]:text-white">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <p class="mt-6 text-sm font-medium uppercase tracking-wider text-white/70">{t.blog.eyebrow}</p>
      <h1 id="blog-hero-title" class="mt-3 max-w-3xl text-4xl font-bold uppercase leading-tight text-white md:text-5xl">
        {t.blog.heroTitle}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/80 md:text-lg">{t.blog.subtitle}</p>

      <label class="mt-8 flex w-full max-w-xl items-center gap-3 rounded-xl border border-white/25 bg-black/40 px-4 py-3 text-white shadow-sm backdrop-blur-sm">
        <Icon name="search" size={18} />
        <input
          id="blog-search"
          type="search"
          placeholder={t.blog.searchPlaceholder}
          aria-label={t.blog.searchPlaceholder}
          class="w-full bg-transparent text-sm text-white outline-none placeholder:text-white/60"
        />
      </label>
    </div>
  </section>

  <section class="border-b border-border bg-muted/20 py-12 md:py-16" aria-labelledby="blog-latest-title">
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h2 id="blog-latest-title" class="section-header__title">{t.blog.latestTitle}</h2>
        <p class="section-header__subtitle">{t.blog.latestSubtitle}</p>
      </header>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter articles by topic"
        >
          <button
            type="button"
            class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
            data-blog-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAll}
          </button>
          {
            tags.map((tag) => (
              <button
                type="button"
                class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                data-blog-filter={tag}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect />
      </div>

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {blogPosts.map((post, index) => (
          <BlogCard post={post} index={index} eager={index === 0} showDate />
        ))}
      </div>

      <p id="blog-empty" class="mt-10 hidden text-center text-muted-foreground" role="status">
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </Button>
      </div>
    </div>
  </section>

  <script>
    import { initBlogIndexFilters } from '../../scripts/blog-index.ts';

    const startBlogFilters = () => {
      const emptyMessage = document.getElementById('blog-empty')?.textContent?.trim() ?? '';
      initBlogIndexFilters(emptyMessage);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startBlogFilters);
    } else {
      startBlogFilters();
    }
  </script>
</BaseLayout>
