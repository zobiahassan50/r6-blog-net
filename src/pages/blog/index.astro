---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, getBlogTags } from '../../data/blog';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES, blogPostPath } from '../../utils/path';
import {
  CARD_IMAGE_WIDTHS,
  HERO_BG_SIZES,
  HERO_BG_WIDTHS,
  avifSrc,
  defaultWebpSrc,
  responsiveAvifSrcSet,
  responsiveSrcSet,
} from '../../utils/responsiveImage';

const seo = resolvePageSeo('/blog/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const tags = getBlogTags();
const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
const firstPost = blogPosts[0];
const firstAvifSet = firstPost ? responsiveAvifSrcSet(firstPost.image, CARD_IMAGE_WIDTHS) : undefined;
const firstImagePreload = firstPost
  ? firstAvifSet
    ? avifSrc(firstPost.image, CARD_IMAGE_WIDTHS[0])
    : defaultWebpSrc(firstPost.image, CARD_IMAGE_WIDTHS)
  : null;
const firstImageSrcSet = firstPost
  ? (firstAvifSet ?? responsiveSrcSet(firstPost.image, CARD_IMAGE_WIDTHS, 'webp'))
  : null;
const firstImageType = firstAvifSet ? 'image/avif' : 'image/webp';

const blogHeroSrc = '/images/bloghero.jpeg';
const blogHeroAvif = responsiveAvifSrcSet(blogHeroSrc, HERO_BG_WIDTHS);
const blogHeroWebp = responsiveSrcSet(blogHeroSrc, HERO_BG_WIDTHS, 'webp');
const blogHeroDefault = defaultWebpSrc(blogHeroSrc, HERO_BG_WIDTHS);
const blogHeroPreload = blogHeroAvif
  ? avifSrc(blogHeroSrc, 1280)
  : blogHeroDefault;
const blogHeroPreloadType = blogHeroAvif ? 'image/avif' : 'image/webp';

const searchSuggestions = blogPosts.map((post) => ({
  title: post.title,
  tag: post.tag,
  href: blogPostPath(post.slug),
  titleSearch: post.title.toLowerCase(),
  tagSearch: post.tag.toLowerCase(),
}));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: t.blog.heroTitle,
      description: t.blog.subtitle,
      url: '/blog/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type={blogHeroPreloadType}
    href={blogHeroPreload}
    imagesrcset={blogHeroAvif ?? blogHeroWebp ?? undefined}
    imagesizes={HERO_BG_SIZES}
    fetchpriority="high"
  />
  {
    firstImagePreload && (
      <link
        slot="head"
        rel="preload"
        as="image"
        type={firstImageType}
        href={firstImagePreload}
        imagesrcset={firstImageSrcSet ?? undefined}
        imagesizes="(min-width: 1024px) 352px, (min-width: 640px) 50vw, 100vw"
      />
    )
  }
  <section class="relative border-b border-border bg-background dark:bg-neutral-950" aria-labelledby="blog-hero-title">
    <picture class="pointer-events-none absolute inset-0" aria-hidden="true">
      {blogHeroAvif && (
        <source type="image/avif" srcset={blogHeroAvif} sizes={HERO_BG_SIZES} />
      )}
      {blogHeroWebp && (
        <source type="image/webp" srcset={blogHeroWebp} sizes={HERO_BG_SIZES} />
      )}
      <img
        src={blogHeroDefault}
        srcset={blogHeroWebp}
        sizes={HERO_BG_SIZES}
        alt=""
        class="h-full w-full object-cover brightness-[0.95] dark:brightness-[0.78]"
        width="1920"
        height="1080"
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="absolute inset-0 bg-white/85 dark:bg-black/25" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto flex min-h-[28rem] max-w-6xl flex-col justify-center px-5 py-16 md:min-h-[34rem] md:py-20">
      <div class="text-neutral-800 dark:text-white/90 dark:drop-shadow [&_[data-slot=breadcrumb-link]]:text-neutral-700 [&_[data-slot=breadcrumb-link]:hover]:text-neutral-950 dark:[&_[data-slot=breadcrumb-link]]:text-white/90 dark:[&_[data-slot=breadcrumb-link]:hover]:text-white [&_[data-slot=breadcrumb-page]]:text-neutral-950 dark:[&_[data-slot=breadcrumb-page]]:text-white">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <h1 id="blog-hero-title" class="mt-6 max-w-3xl text-4xl font-bold uppercase leading-tight text-neutral-950 dark:text-white dark:drop-shadow md:text-5xl">
        {t.blog.heroTitle}
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-700 dark:text-white dark:drop-shadow md:text-lg">{t.blog.subtitle}</p>

      <div class="relative z-30 mt-8 w-full max-w-sm" data-blog-search>
        <label class="flex w-full items-center gap-3 rounded-xl border border-neutral-300 bg-white/90 px-4 py-2.5 text-neutral-900 shadow-sm backdrop-blur-sm dark:border-white/25 dark:bg-black/40 dark:text-white">
          <Icon name="search" size={16} class="text-neutral-700 dark:text-white" />
          <input
            id="blog-search"
            type="search"
            placeholder={t.blog.searchPlaceholder}
            aria-label={t.blog.searchPlaceholder}
            aria-autocomplete="list"
            aria-controls="blog-search-menu"
            aria-expanded="false"
            autocomplete="off"
            class="w-full bg-transparent text-sm text-neutral-900 outline-none placeholder:text-neutral-500 dark:text-white dark:placeholder:text-white/60"
          />
        </label>
        <ul
          id="blog-search-menu"
          role="listbox"
          hidden
          class="absolute left-0 right-0 top-full z-50 mt-2 max-h-72 w-full overflow-y-auto rounded-xl border border-neutral-200 bg-white py-1 shadow-lg dark:border-white/20 dark:bg-neutral-950"
        ></ul>
        <script type="application/json" id="blog-search-data" is:inline set:html={JSON.stringify(searchSuggestions)} />
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-muted/20 py-12 md:py-16" aria-labelledby="blog-latest-title">
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h2 id="blog-latest-title" class="section-header__title">{t.blog.latestTitle}</h2>
        <p class="section-header__subtitle">{t.blog.latestSubtitle}</p>
      </header>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter blogs by topic"
        >
          <button
            type="button"
            class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
            data-blog-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAll}
          </button>
          {
            tags.map((tag) => (
              <button
                type="button"
                class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                data-blog-filter={tag}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect />
      </div>

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {blogPosts.map((post, index) => (
          <BlogCard post={post} index={index} eager={index === 0} showDate />
        ))}
      </div>

      <p id="blog-empty" class="mt-10 hidden text-center text-muted-foreground" role="status">
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={ROUTES.blog} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to blog
        </Button>
      </div>
    </div>
  </section>

  <script>
    import { initBlogIndexFilters } from '../../scripts/blog-index.ts';

    const startBlogFilters = () => {
      const emptyMessage = document.getElementById('blog-empty')?.textContent?.trim() ?? '';
      initBlogIndexFilters(emptyMessage);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startBlogFilters);
    } else {
      startBlogFilters();
    }
  </script>
</BaseLayout>
