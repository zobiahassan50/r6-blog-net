---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { resolvePageSeo } from '../config/seo';
import { faqPageSchema, homepageProductSchema, organizationSchema, videoObjectSchema, websiteSchema } from '../utils/schema';
import { faqData } from '../data/faqData';
import { HERO_BG_PRELOAD_WIDTHS, HERO_BG_SIZES } from '../utils/responsiveImage';
import { buildImagePreload } from '../utils/preloadImage';

const seo = resolvePageSeo('/');
const homeFaqs = faqData;
const heroPreload = await buildImagePreload(
  '/images/herobackground.png',
  HERO_BG_PRELOAD_WIDTHS,
  HERO_BG_SIZES,
  640,
);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema(), homepageProductSchema(), videoObjectSchema(), faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  {
    heroPreload && (
      <link
        slot="head"
        rel="preload"
        as="image"
        type={heroPreload.type}
        href={heroPreload.href}
        imagesrcset={heroPreload.imagesrcset}
        imagesizes={heroPreload.imagesizes}
        fetchpriority="high"
      />
    )
  }
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
