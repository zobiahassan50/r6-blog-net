---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../utils/path';
---

<BaseLayout
  title={`Page not found | ${t.site.name}`}
  description="That URL is not on r6cheat.net. Use the links below to continue."
  noindex={true}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold uppercase md:text-4xl">Page not found</h1>
      <p class="mt-4 text-muted-foreground">
        That URL does not exist on r6cheat.net or may have moved after a redirect cleanup.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        Try the homepage for Rainbow Six Siege cheats overview, open the products hub for ESP and aimbot notes, or browse
        the blog for guides and patch checklists. The FAQ and Support pages cover buying questions and loader help.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        If you followed an old bookmark for Lite, Pro, or a renamed article, use the Elite product or blog index links
        below—those routes replace outdated paths.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
        <Button as="a" href={ROUTES.home} variant="primary">
          Home
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={ROUTES.products} variant="outline">Products</Button>
        <Button as="a" href={ROUTES.productsElite} variant="outline">Elite product</Button>
        <Button as="a" href={ROUTES.blog} variant="outline">Blog</Button>
        <Button as="a" href={ROUTES.faq} variant="outline">FAQ</Button>
        <Button as="a" href={ROUTES.support} variant="outline">Support</Button>
      </div>
    </div>
  </section>
</BaseLayout>
